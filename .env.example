PORT=8080
APP_ENV=development
SERVICE_NAME=fiapx-video-service

# postgres://user:password@host:5432/dbname?sslmode=disable
DB_URL=postgres://video:video@localhost:5434/fiapx_video?sslmode=disable

# Shared HS256 secret — MUST match fiapx-auth-service's JWT_SECRET.
JWT_SECRET=change-me-to-a-random-32-byte-value

REDIS_ADDR=localhost:6379
S3_BUCKET=fiapx-videos-dev
AWS_REGION=us-east-1
KAFKA_BROKERS=localhost:9092
